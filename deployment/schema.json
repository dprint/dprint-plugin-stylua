{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plugins.dprint.dev/dprint/dprint-plugin-stylua/0.0.0/schema.json",
  "type": "object",
  "x-playground": {
    "input": [
      "local json=require('json')",
      "",
      "local Inventory={}",
      "Inventory.__index=Inventory",
      "",
      "function Inventory.new(items)",
      "local self=setmetatable({},Inventory)",
      "  self.items=items or {}",
      "    return self",
      "end",
      "",
      "function Inventory:add(name,count)",
      "  if not name then return end",
      "  self.items[name]=(self.items[name] or 0)+count",
      "end",
      "",
      "function Inventory:total()",
      "    local sum=0",
      "    for _,count in pairs(self.items) do sum=sum+count end",
      "    return sum",
      "end",
      "",
      "local inventory=Inventory.new({apples=3,pears=2})",
      "inventory:add('plums',5)",
      "print(string.format('total: %d',inventory:total()),json.encode(inventory.items))"
    ]
  },
  "x-sections": [
    {
      "title": "General",
      "description": "The syntax, width, indentation, and newlines of all the code.",
      "properties": [
        "syntax",
        "lineWidth",
        "useTabs",
        "indentWidth",
        "newLineKind"
      ]
    },
    {
      "title": "Strings and calls",
      "description": "The quotes of strings and the parentheses and spaces of function calls and definitions.",
      "properties": [
        "quoteStyle",
        "callParentheses",
        "spaceAfterFunctionNames"
      ]
    },
    {
      "title": "Statements and blocks",
      "description": "When simple statements go on one line, the blank lines in blocks, and the order of `require` statements.",
      "properties": [
        "collapseSimpleStatement",
        "blockNewlineGaps",
        "sortRequires"
      ]
    }
  ],
  "properties": {
    "syntax": {
      "description": "The Lua syntax to parse.",
      "type": "string",
      "default": "all",
      "oneOf": [{
        "const": "all",
        "description": "Parses all supported syntaxes at once. Select a specific one when syntaxes conflict (ex. Lua 5.2 labels and Luau type assertions)."
      }, {
        "const": "lua51",
        "description": "Lua 5.1."
      }, {
        "const": "lua52",
        "description": "Lua 5.2."
      }, {
        "const": "lua53",
        "description": "Lua 5.3."
      }, {
        "const": "lua54",
        "description": "Lua 5.4."
      }, {
        "const": "luau",
        "description": "Luau."
      }, {
        "const": "luajit",
        "description": "LuaJIT."
      }, {
        "const": "cfxlua",
        "description": "CfxLua (FiveM)."
      }]
    },
    "lineWidth": {
      "description": "The width of a line the formatter will try to stay under. Note that this limit will be exceeded in some cases.",
      "default": 120,
      "type": "integer",
      "minimum": 1
    },
    "useTabs": {
      "description": "Whether to indent with tabs instead of spaces.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "local function greet(name)",
          "if name then",
          "print(\"Hello, \" .. name)",
          "end",
          "end"
        ]
      }
    },
    "indentWidth": {
      "description": "The number of spaces for an indent. With tabs, this is the width of a tab when deciding where to wrap lines.",
      "default": 4,
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "newLineKind": {
      "description": "The kind of newline to use.",
      "type": "string",
      "default": "lf",
      "oneOf": [{
        "const": "auto",
        "description": "For each file, uses the newline kind found at the end of the last line."
      }, {
        "const": "crlf",
        "description": "Uses carriage return, line feed."
      }, {
        "const": "lf",
        "description": "Uses line feed."
      }]
    },
    "quoteStyle": {
      "description": "The style of quotes to use in string literals.",
      "type": "string",
      "default": "autoPreferDouble",
      "oneOf": [{
        "const": "autoPreferDouble",
        "description": "Uses double quotes, unless single quotes need fewer escapes."
      }, {
        "const": "autoPreferSingle",
        "description": "Uses single quotes, unless double quotes need fewer escapes."
      }, {
        "const": "forceDouble",
        "description": "Always uses double quotes."
      }, {
        "const": "forceSingle",
        "description": "Always uses single quotes."
      }],
      "x-example": {
        "input": [
          "local greeting = 'Hello'",
          "local quote = 'She said \"hi\"'",
          "local reply = \"It's fine\""
        ]
      }
    },
    "callParentheses": {
      "description": "When to use parentheses around the arguments of a function call.",
      "type": "string",
      "default": "always",
      "oneOf": [{
        "const": "always",
        "description": "Always uses parentheses."
      }, {
        "const": "noSingleString",
        "description": "Omits the parentheses when the only argument is a string."
      }, {
        "const": "noSingleTable",
        "description": "Omits the parentheses when the only argument is a table."
      }, {
        "const": "none",
        "description": "Omits the parentheses when the only argument is a string or a table."
      }, {
        "const": "input",
        "description": "Keeps the parentheses as they are in the input."
      }],
      "x-example": {
        "input": [
          "local json = require(\"json\")",
          "print \"ready\"",
          "setup({ debug = true })"
        ]
      }
    },
    "collapseSimpleStatement": {
      "description": "Which simple statements to collapse onto a single line.",
      "type": "string",
      "default": "never",
      "oneOf": [{
        "const": "never",
        "description": "Never collapses them."
      }, {
        "const": "input",
        "description": "Keeps them collapsed or expanded as they are in the input."
      }, {
        "const": "functionOnly",
        "description": "Collapses simple functions."
      }, {
        "const": "conditionalOnly",
        "description": "Collapses simple `if` guards."
      }, {
        "const": "always",
        "description": "Collapses simple functions and `if` guards."
      }],
      "x-example": {
        "input": [
          "local function double(x) return x * 2 end",
          "local function half(x)",
          "\treturn x / 2",
          "end",
          "if not ready then return end"
        ]
      }
    },
    "blockNewlineGaps": {
      "description": "Whether blocks keep the blank lines at their start and end.",
      "type": "string",
      "default": "never",
      "oneOf": [{
        "const": "never",
        "description": "Removes them."
      }, {
        "const": "preserve",
        "description": "Keeps them when they are in the input."
      }],
      "x-example": {
        "input": [
          "local function load(path)",
          "",
          "\tlocal file = io.open(path)",
          "\treturn file:read(\"a\")",
          "",
          "end"
        ]
      }
    },
    "spaceAfterFunctionNames": {
      "description": "Where to put a space between a function name and its parameters or arguments.",
      "type": "string",
      "default": "never",
      "oneOf": [{
        "const": "never",
        "description": "Never."
      }, {
        "const": "definitions",
        "description": "In function definitions."
      }, {
        "const": "calls",
        "description": "In function calls."
      }, {
        "const": "always",
        "description": "In function definitions and calls."
      }],
      "x-example": {
        "input": [
          "local function add(a, b)",
          "\treturn a + b",
          "end",
          "print(add(1, 2))"
        ]
      }
    },
    "sortRequires": {
      "description": "Whether to sort consecutive `require` statements by their variable name.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "local utils = require(\"utils\")",
          "local config = require(\"config\")",
          "local logger = require(\"logger\")"
        ]
      }
    }
  }
}
